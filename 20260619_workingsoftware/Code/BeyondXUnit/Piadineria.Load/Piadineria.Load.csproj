<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NBomber porta in transitivo MessagePack con una CVE nota (NU1903): non è la
         dipendenza vulnerabile della demo §5c (quella è Newtonsoft in Piadineria.Vulnerable),
         quindi la silenziamo qui per non sporcare il messaggio sulla CVE "voluta". -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- Mvc.Testing avvia la WebApp in-memory: serve il framework condiviso ASP.NET. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" Version="6.4.1" />
    <PackageReference Include="NBomber.Http" Version="6.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HexagonalPiadineria\src\HexagonalPiadineria.WebApp\HexagonalPiadineria.WebApp.csproj" />
  </ItemGroup>

</Project>
