      },
      "title": "Orders by service and outcome",
      "datasource": {
        "uid": "restaurant-prometheus",
        "type": "prometheus"
      },
      "type": "timeseries",
      "targets": [
        {
          "legendFormat": "{{service_name}} {{outcome}} {{queue}} {{job}}",
          "expr": "sum by (service_name, outcome) (restaurant_orders_total)",
          "refId": "A"
        }
      ],
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
