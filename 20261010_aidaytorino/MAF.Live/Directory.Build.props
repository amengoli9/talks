<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Harness providers and evaluation still expose experimental APIs. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Demo.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)Common/*.cs" Link="Common/%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)../appsettings.local.json"
          Condition="Exists('$(MSBuildThisFileDirectory)../appsettings.local.json')"
          Link="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
